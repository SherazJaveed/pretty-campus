{
  "manifest_version": 3,
  "name": "Pretty Campus - Canvas Dark Mode & GPA",
  "version": "3.0.0",
  "description": "All-in-one Canvas LMS extension: dark mode, GPA calculator, auto-save, Pomodoro timer, smart notifications, achievement badges, study planner & 40+ university themes.",
  "icons": {
    "16": "src/assets/icons/icon-16.png",
    "48": "src/assets/icons/icon-48.png",
    "128": "src/assets/icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "src/assets/icons/icon-16.png",
      "48": "src/assets/icons/icon-48.png",
      "128": "src/assets/icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["src/content/content.js"],
      "css": ["src/content/content.css"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["storage"]
}
